{
  "name": "pi-retry-forced",
  "version": "1.2.0",
  "description": "Keep Pi running through LLM-relay 400s: retry errors its substring classifier misses, and strip replayed thinking signatures a pooled relay rejects.",
  "type": "module",
  "license": "MIT",
  "author": "yiki21",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "retry",
    "proxy",
    "anthropic",
    "reliability",
    "thinking",
    "signature"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yiki21/pi-retry-forced.git"
  },
  "bugs": {
    "url": "https://github.com/Yiki21/pi-retry-forced/issues"
  },
  "homepage": "https://github.com/Yiki21/pi-retry-forced#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
